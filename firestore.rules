rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is authenticated (Google or Anonymous)
    function isAuthenticated() {
      return request.auth != null;
    }

    // 1. Users collection - allows profile sync for authenticated and guest users
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
    }

    // 2. Donors collection
    match /donors/{donorId} {
      allow read: if true;
      allow create, update: if true;
    }

    // 3. SOS reports collection - public emergency distress reports
    match /sos_reports/{reportId} {
      allow read: if true;
      allow create: if true;
      allow update, delete: if true;
    }

    // 4. Donations collection with transparent ledger tracking
    match /donations/{donationId} {
      allow read: if true; // Public transparency ledger
      allow create: if true;
      allow update: if true;
      allow delete: if false; // Immutable ledger
    }

    // 5. Catch-all for safety circle and disaster alerts
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
